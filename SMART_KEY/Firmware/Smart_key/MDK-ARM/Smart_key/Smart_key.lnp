--cpu Cortex-M0+
"smart_key\startup_stm32g030xx.o"
"smart_key\main.o"
"smart_key\stm32g0xx_it.o"
"smart_key\stm32g0xx_hal_msp.o"
"smart_key\stm32g0xx_hal_spi.o"
"smart_key\stm32g0xx_hal_spi_ex.o"
"smart_key\stm32g0xx_hal_rcc.o"
"smart_key\stm32g0xx_hal_rcc_ex.o"
"smart_key\stm32g0xx_ll_rcc.o"
"smart_key\stm32g0xx_hal_flash.o"
"smart_key\stm32g0xx_hal_flash_ex.o"
"smart_key\stm32g0xx_hal_gpio.o"
"smart_key\stm32g0xx_hal_dma.o"
"smart_key\stm32g0xx_hal_dma_ex.o"
"smart_key\stm32g0xx_hal_pwr.o"
"smart_key\stm32g0xx_hal_pwr_ex.o"
"smart_key\stm32g0xx_hal_cortex.o"
